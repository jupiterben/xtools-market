{
  "name": "xtools-market",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit && tsc -p tools/tsconfig.json",
    "tools:check": "tsx scripts/check-tools.ts",
    "test": "tsx --test tests/*.test.ts",
    "keys:init": "tsx scripts/init-keys.ts",
    "tools:release": "tsx scripts/release-tools.ts",
    "registry:verify": "tsx scripts/verify-registry.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^11.2.0",
    "fastify": "^5.0.0",
    "semver": "^7.7.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@noble/hashes": "^2.4.0",
    "@types/node": "^24.0.0",
    "@types/semver": "^7.7.0",
    "diff": "^8.0.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "uuid": "^14.0.2",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
